# Server (set these in GitHub Secrets for CI/CD)
SERVER_HOST=your-server-ip
SERVER_USER=ubuntu
SERVER_SSH_KEY=/path/to/your/ssh-key

# WeChat JS-SDK signature (/play route). Real values go in docker/.env on the server.
# AppSecret is only visible in the 公众号 backend (AppID: wx6ad7009a1736a702).
WECHAT_APPID=wx6ad7009a1736a702
WECHAT_SECRET=
